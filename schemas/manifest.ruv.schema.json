{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ruvnet/ruvnet/main/schemas/manifest.ruv.schema.json",
  "title": "ruvnet constellation manifest v0.1",
  "description": "Discovery metadata only. Public visibility is a publisher declaration requiring independent review. URI resolution, execution and authorization are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "summary", "repository", "nexus", "capabilities", "artifacts", "relationships", "integrations", "safety", "provenance"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"$ref": "#/$defs/identity"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "defaultBranch", "visibility"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://github\\.com/ruvnet/[A-Za-z0-9._-]+$"},
        "defaultBranch": {"type": "string", "minLength": 1, "maxLength": 200},
        "visibility": {"enum": ["public", "private"]}
      }
    },
    "nexus": {"const": "https://github.com/ruvnet/ruvnet"},
    "capabilities": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "status", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "status": {"$ref": "#/$defs/status"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "artifacts": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "kind"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "url": {"$ref": "#/$defs/https"},
          "kind": {"enum": ["source", "docs", "package", "data"]}
        }
      }
    },
    "relationships": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "target", "status", "evidence"],
        "properties": {
          "type": {"$ref": "#/$defs/slug"},
          "target": {"$ref": "#/$defs/identity"},
          "status": {"$ref": "#/$defs/status"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "integrations": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "project", "status"],
        "properties": {
          "role": {"$ref": "#/$defs/slug"},
          "project": {"$ref": "#/$defs/identity"},
          "status": {"const": "declared"}
        }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["discoveryOnly", "executionRequiresAuthorization"],
      "properties": {"discoveryOnly": {"const": true}, "executionRequiresAuthorization": {"const": true}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommit", "observedAt"],
      "properties": {
        "sourceCommit": {"$ref": "#/$defs/revision"},
        "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 100},
    "identity": {"type": "string", "pattern": "^ruv://ruvnet/constellation/service/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?/resources/manifest\\.ruv$"},
    "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "status": {"enum": ["documented", "tested", "planned"]},
    "https": {"type": "string", "pattern": "^https://(?:github\\.com|raw\\.githubusercontent\\.com|www\\.npmjs\\.com|crates\\.io|docs\\.rs)/[^\\s?#]+$", "maxLength": 2000},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "revision", "kind"],
      "properties": {
        "url": {"$ref": "#/$defs/https"},
        "revision": {"$ref": "#/$defs/revision"},
        "kind": {"enum": ["documentation", "source", "test"]}
      }
    }
  }
}
